# Database Connection (SQLite default for zero-config local run, PostgreSQL supported for production)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET="last_mile_delivery_tracker_super_secret_jwt_key_2026"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notification Provider Config (Optional for real SMTP, mock logger provided)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notifications@deliverytracker.com"

# Simulated Mode (true keeps in-app notification logs visible in UI)
ENABLE_SIMULATED_NOTIFICATIONS="true"
